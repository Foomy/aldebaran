<!DOCTYPE html>
<!--suppress HtmlUnknownTarget -->
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{{ "header.subtitle" | trans }}{% block title %}{% endblock %}</title>

    <link rel="icon" href="favicon.svg" type="image/x-icon">

    {% block stylesheets %}
        {{ encore_entry_link_tags('css/app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('js/app') }}
    {% endblock %}
</head>
<body>
<header>
    <div class="header-content">
        <div class="logo">
            <img src="https://dummyimage.com/110.png/aaa/000&text=Logo" alt="">
        </div>
        <div class="title">
            <h1>{{ "h1.header.maintitle" | trans }}</h1>
            <h2>{{ "h2.header.subtitle" | trans }}</h2>
        </div>
    </div>
</header>

<div id="page-wrapper">
    <nav class="main-nav">
        {{ include('_main-navigation.html.twig') }}
    </nav>

    <div class="content">{% block body %}{% endblock %}</div>
</div>

<footer>
    <div class="footer-content">
        <blockquote class="footer-quote">
            <p class="quote">Wenn's um Ernährung geht, ist gar nichts einfach.</p>
            <p class="source">Mai Thi Nguyen-Kim</p>
        </blockquote>
    </div>
</footer>
</body>
</html>
