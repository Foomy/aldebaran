{% extends 'base.html.twig' %}

{% block title %}Hello BloodSugarController!{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('js/BloodSugar') }}
    {{ encore_entry_script_tags('js/blood-sugar/ValueTable') }}
{#    {{ encore_entry_script_tags('js/blood-sugar/Form') }}#}
    <script>
        window.document.addEventListener('DOMContentLoaded', (event) => {
            const doc = event.target;
            BloodSugar.init(doc);
        });
    </script>
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row row-heading">
            <h3>h3.measurement.values</h3>
        </div>
        <div class="row row-controls">
            <div class="col-12">
                <button class="btn btn-success" type="button" data-js="add-bs-measurement">
                    <i class="fas fa-plus-circle"></i> {{ "ctrl.add"|trans }}
                </button>
            </div>
        </div>
        <div class="row row-content">
            {% if measurements is empty %}
                <div class="col-12">
                    <div class="alert alert-primary mt-3" role="alert">
                        <span class="fas fa-info-circle"></span>
                        {{ "no.data.here.yet"|trans }}
                    </div>
                </div>
            {% else %}
                <div class="col-4">
                    <table class="sugar-values table">
                        <thead>
                        <tr>
                            <td>{{ "svt.th.time"|trans }}</td>
                            <td>{{ "svt.th.value"|trans }}</td>
                            <td>{{ "svt.th.actions"|trans }}</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for measurement in measurements %}
                            <tr>
                                <td>{{ measurement.measurementTime.format('d.m.Y H:i') }}</td>
                                <td>{{ measurement.bloodSugarValue }}</td>
                                <td>
                                    <button class="btn btn-primary" type="button" data-js="edit-bs-measurement" data-id="{{ measurement.id }}">
                                        <i class="fas fa-pencil"></i>
                                    </button>
                                    <button class="btn btn-danger" type="button" data-js="del-bs-measurement" data-id="{{ measurement.id }}">
                                        <i class="fas fa-minus-circle"></i>
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="col-8">[DIAGRAM]</div>
            {% endif %}
        </div>
    </div>
{% endblock %}
